#!/bin/bash
# ppcosx - run PowerPC Mac OS X (Tiger) on a Mac or Linux with an
# emulated ATI Radeon 9700 PRO whose 3D engine is translated to Metal
# (macOS) or Vulkan (macOS through MoltenVK, and Linux).
#
#   ./ppcosx help        for the command list
#   docs/                for the long version
#
# Written for the bash 3.2 that ships with macOS: no associative arrays,
# no ${var,,}, no mapfile.
set -u

resolve() {   # print the real path of $1, following symlinks
    local f="$1" l
    while [ -L "$f" ]; do
        l=$(readlink "$f")
        case "$l" in /*) f="$l" ;; *) f="$(dirname "$f")/$l" ;; esac
    done
    printf '%s/%s\n' "$(cd "$(dirname "$f")" && pwd -P)" "$(basename "$f")"
}
# Follow symlinks (ppcosx link puts one on the PATH) back to the checkout.
REPO=$(dirname "$(resolve "$0")")
# How to tell the user to call us: plain "ppcosx" once it's on the PATH.
PROG=./ppcosx
if command -v ppcosx >/dev/null 2>&1 && [ "$(resolve "$(command -v ppcosx)")" = "$REPO/ppcosx" ]; then
    PROG=ppcosx
fi
VM_DIR="${PPCOSX_VM_DIR:-$REPO/vm}"
QEMU_DIR="$REPO/qemu"
QEMU_BUILD="$QEMU_DIR/build"
# Linux can use a prebuilt QEMU (GitHub release "qemu-<commit>", made by
# tools/build-linux-qemu.sh); "ppcosx setup" downloads it into prebuilt/.
PREBUILT_DIR="$REPO/prebuilt"
PREBUILT_REPO="${PPCOSX_RELEASES:-linuxkid473/ppcosxkvm}"
if [ -z "${PPCOSX_QEMU:-}" ] && [ -x "$PREBUILT_DIR/bin/qemu-system-ppc" ]; then
    QEMU="$PREBUILT_DIR/bin/qemu-system-ppc"
    QEMU_IMG_BUILT="$PREBUILT_DIR/bin/qemu-img"
    QEMU_DATA="$PREBUILT_DIR/share/pc-bios"
else
    QEMU="${PPCOSX_QEMU:-$QEMU_BUILD/qemu-system-ppc}"
    QEMU_IMG_BUILT="$QEMU_BUILD/qemu-img"
    QEMU_DATA="$QEMU_DIR/pc-bios"
fi
FW_RADEON="$REPO/firmware/radeon"
FW_VGA="$REPO/firmware/vga"
DISK_DEFAULT="$VM_DIR/macosx.qcow2"
ROM_DEFAULT="$VM_DIR/roms/radeon9700.rom"
CPU_MHZ_DEFAULT=2000  # CPU speed Mac OS X is told (reporting only; QEMU says 900)
# Model Mac OS X is told (hw.model).  A G4 PowerBook, because apps' minimum
# requirement checks (Aperture) accept a G4 only in a PowerBook; the
# firmware's own "PowerMac3,1" would need a G5.  "default" keeps that.
MODEL_DEFAULT=PowerBook5,8
RADEON_SLOT=e         # PCI slot of the Radeon; names its device-tree node
BREW_DEPS="ninja pkgconf glib pixman libslirp shaderc spirv-cross glslang vulkan-headers vulkan-loader molten-vk"
# The same from MacPorts, for Intel Macs (which Homebrew no longer supports),
# plus a Python for the build: the Command Line Tools' one may be too old.
PORT_DEPS="ninja pkgconfig glib2 libpixman libslirp shaderc spirv-cross glslang vulkan-headers vulkan-loader MoltenVK python313"
# Linux build and run dependencies, per package manager: QEMU's (glib,
# pixman, slirp, GTK display, PulseAudio/PipeWire sound), the Vulkan
# loader and a driver, and the shader toolchain (shaderc, SPIRV-Cross).
# What a prebuilt QEMU needs at run time (Ubuntu 24.04 / Debian 13 names).
APT_RUNTIME_DEPS="git curl ca-certificates xz-utils python3 libglib2.0-0t64
    libpixman-1-0 libslirp0 libgtk-3-0t64 libpulse0 libvulkan1
    mesa-vulkan-drivers libshaderc1 libspirv-cross-c-shared0"
APT_DEPS="build-essential git ninja-build pkg-config python3 python3-venv flex bison
    libglib2.0-dev libpixman-1-dev libslirp-dev libgtk-3-dev libpulse-dev
    libvulkan-dev mesa-vulkan-drivers libshaderc-dev libspirv-cross-c-shared-dev
    glslang-tools spirv-tools"
DNF_DEPS="gcc gcc-c++ make git ninja-build pkgconf-pkg-config python3 flex bison
    glib2-devel pixman-devel libslirp-devel gtk3-devel pulseaudio-libs-devel
    vulkan-loader-devel vulkan-headers mesa-vulkan-drivers libshaderc-devel
    spirv-cross-devel glslang spirv-tools"
PACMAN_DEPS="base-devel git ninja pkgconf python flex bison glib2 pixman libslirp
    gtk3 libpulse vulkan-icd-loader vulkan-headers shaderc spirv-cross glslang
    spirv-tools"
HOST_OS=$(uname -s)
[ "$HOST_OS" = Darwin ] && IS_MAC=1 || IS_MAC=0

# Apple Silicon hardware, even from a shell running under Rosetta.
apple_silicon() {
    [ "$IS_MAC" = 1 ] && [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ]
}

# MacPorts lives in /opt/local; a shell opened before it was installed
# doesn't have it on the PATH yet.
[ "$IS_MAC" = 1 ] && ! command -v port >/dev/null 2>&1 && [ -x /opt/local/bin/port ] \
    && PATH="/opt/local/bin:/opt/local/sbin:$PATH"
# Likewise Homebrew.
if [ "$IS_MAC" = 1 ] && ! command -v brew >/dev/null 2>&1; then
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$b" ] && eval "$("$b" shellenv)" && break
    done
fi

# The Mac package manager to use: PPCOSX_PKG=brew|macports, else Homebrew
# on Apple Silicon and MacPorts on Intel, whichever is installed first.
mac_pm() {
    case "${PPCOSX_PKG:-}" in brew|macports) echo "$PPCOSX_PKG"; return ;; esac
    local order="brew macports" pm
    apple_silicon || order="macports brew"
    for pm in $order; do
        case "$pm" in
            brew) command -v brew >/dev/null 2>&1 && { echo brew; return; } ;;
            macports) command -v port >/dev/null 2>&1 && { echo macports; return; } ;;
        esac
    done
    echo "${order%% *}"          # none installed: the one to ask for
}

mac_missing() {   # packages of $1's list that aren't installed
    local pm="$1" p missing=
    if [ "$pm" = brew ]; then
        for p in $BREW_DEPS; do
            brew list --formula "$p" >/dev/null 2>&1 || missing="$missing $p"
        done
    else
        for p in $PORT_DEPS; do
            port -q installed "$p" 2>/dev/null | grep -q "(active)" || missing="$missing $p"
        done
    fi
    echo "$missing"
}

# ---------------------------------------------------------------- output ---
if [ -t 1 ]; then
    B=$'\033[1m'; R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; D=$'\033[2m'; N=$'\033[0m'
else
    B=; R=; G=; Y=; D=; N=
fi
say()  { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$R" "$N" "$*"; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
hint() { printf '    %s%s%s\n' "$D" "$*" "$N"; }

qemu_img() {
    if [ -x "$QEMU_IMG_BUILT" ]; then "$QEMU_IMG_BUILT" "$@"
    elif command -v qemu-img >/dev/null 2>&1; then qemu-img "$@"
    else die "qemu-img not found - run $PROG setup first"; fi
}

need_qemu() {
    [ -x "$QEMU" ] || die "QEMU is not built yet. Run:  $PROG setup"
}

abspath() {
    case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s/%s\n' "$(pwd -P)" "$1" ;; esac
}

human_size() {   # bytes -> "20 GB"
    awk -v b="$1" 'BEGIN { split("B KB MB GB TB", u); i = 1;
        while (b >= 1024 && i < 5) { b /= 1024; i++ } printf "%.0f %s\n", b, u[i] }'
}

disk_size() {    # virtual size in bytes
    qemu_img info -U --output=json "$1" 2>/dev/null |
        /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["virtual-size"])'
}

disk_in_use() {   # is a QEMU on this machine running this exact disk path?
    ps axww -o command= 2>/dev/null | grep -F "qemu-system-ppc" | grep -qF "file.filename=$1,"
}

# Nothing listening on 127.0.0.1:$1 (bash's /dev/tcp: no lsof/ss needed).
port_free() { ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

ncpu() { nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 8; }

sha1_check() {   # sha1_check SUMSFILE, in the current directory
    if command -v shasum >/dev/null 2>&1; then shasum -c "$1"
    else sha1sum -c "$1"; fi
}

# The Linux package manager: apt, dnf or pacman (empty if none of them).
linux_pm() {
    if command -v apt-get >/dev/null 2>&1; then echo apt
    elif command -v dnf >/dev/null 2>&1; then echo dnf
    elif command -v pacman >/dev/null 2>&1; then echo pacman
    fi
}

linux_deps() {   # the package list for $1
    case "$1" in
        apt) echo $APT_DEPS ;;
        dnf) echo $DNF_DEPS ;;
        pacman) echo $PACMAN_DEPS ;;
    esac
}

linux_missing() {   # packages of $1's list (or of list $2) that aren't installed
    local pm="$1" p missing= list="${2:-$(linux_deps "$1")}"
    for p in $list; do
        case "$pm" in
            apt) dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "ok installed" ;;
            dnf) rpm -q "$p" >/dev/null 2>&1 ;;
            pacman) pacman -Qi "$p" >/dev/null 2>&1 || pacman -Qg "$p" >/dev/null 2>&1 ;;
        esac || missing="$missing $p"
    done
    echo $missing
}

# ------------------------------------------------------------------ help ---
usage() {
    cat <<EOF
${B}ppcosx${N} - PowerPC Mac OS X (Tiger) on a Mac or Linux, with an emulated
ATI Radeon 9700 PRO (Quartz Extreme, Core Image and OpenGL via Metal or Vulkan).

${B}First time${N}
  ppcosx install <tiger.iso>   install Mac OS X from a DVD image (.iso .cdr .dmg .toast)
    or
  ppcosx import <disk>         use an existing PowerPC OS X disk
                               (.qcow2 .vmdk .vdi .vhd .img .utm bundle)
  ppcosx rom <file.rom>        (optional) your Mac Radeon 9700 PRO ROM

${B}Every day${N}
  ppcosx                       boot the VM with the Radeon 9700 (3D acceleration)
  ppcosx --vga                 boot with a plain framebuffer (safe mode)
  ppcosx --attach-dvd <file>   boot with a DVD/CD image inserted (.iso .dmg ...)
  ppcosx --ram 2048 --verbose  any run option works directly (see below)
  ppcosx doctor                check that everything is in place

${B}Disks${N}
  ppcosx new-disk [size] [path]  create an empty disk (default 40G at vm/macosx.qcow2)
  ppcosx snapshot list|save|restore|delete [name]
                               disk snapshots (VM must be shut down)

${B}Maintenance${N}
  ppcosx update                get the latest version and rebuild
  ppcosx setup [--build]       install what's needed and (re)build QEMU (Linux:
                               downloads a prebuilt QEMU; --build compiles it)
  ppcosx link | unlink         add or remove the 'ppcosx' command on your PATH

${B}Run options${N} (for "ppcosx", "ppcosx run" and "ppcosx install")
  --disk PATH      disk image to boot        (default: vm/macosx.qcow2)
  --ram MB         guest memory, 256-2048    (default: 1024)
  --cpu-mhz N      CPU speed Mac OS X sees   (default: $CPU_MHZ_DEFAULT; reporting only)
  --model NAME     Mac model Mac OS X sees   (default: $MODEL_DEFAULT; "default" = PowerMac3,1)
  --vram MB        Radeon video memory 64/128/256 (default: 128)
  --res WxH        screen size               (default: 1024x768)
  --rom PATH       Radeon ROM to use         (default: vm/roms/radeon9700.rom if present)
  --no-rom         boot without the ROM, even if one is installed
  --vga            plain framebuffer instead of the Radeon
  --gpu API        host 3D API for the Radeon: metal (macOS default) or
                   vulkan (Linux default; MoltenVK on macOS)
  --gpumetal       same as --gpu metal
  --gpuvulkan      same as --gpu vulkan (MoltenVK on macOS)
  --attach-dvd IMG DVD/CD image to insert: .iso .cdr .dmg .toast (also --dvd)
  --verbose        verbose (text) boot instead of the grey Apple
  --snapshot       throw away all disk writes when the VM quits
  --no-audio       no sound (Mac OS X runs normally, nothing reaches your speakers)
  --ssh-port N     forward host 127.0.0.1:N to guest port 22
  --monitor        QEMU monitor on 127.0.0.1:4444 (HMP) and :4445 (QMP)
  --trace-gpu      log every GPU register access to vm/gpu-trace.log (slow)
  -- ARGS...       pass the remaining arguments straight to QEMU

Files live in $VM_DIR (override with PPCOSX_VM_DIR).
Program: $REPO   Docs: https://github.com/linuxkid473/ppcosxkvm/tree/main/docs
EOF
    if [ "$PROG" != ppcosx ]; then
        printf '\n%sppcosx is not on your PATH yet: type %s instead, or run "%s link".%s\n' "$Y" "$PROG" "$PROG" "$N"
    fi
}

# ----------------------------------------------------------------- setup ---
cmd_setup() {
    local build=0
    case "${1:-}" in
        --build) build=1 ;;
        '') ;;
        *) die "usage: $PROG setup [--build]" ;;
    esac
    if [ "$IS_MAC" = 1 ]; then
        setup_mac
    elif [ "$HOST_OS" = Linux ]; then
        # A prebuilt QEMU when there is one for this version, else build.
        if [ "$build" = 0 ] && setup_linux_prebuilt; then
            setup_done
            return 0
        fi
        setup_linux
    else
        die "ppcosx runs on macOS and Linux only (this is $HOST_OS)"
    fi
    rm -rf "$PREBUILT_DIR"
    QEMU="${PPCOSX_QEMU:-$QEMU_BUILD/qemu-system-ppc}"
    setup_build
}

linux_install() {   # linux_install PM WHAT PACKAGES...: install what's missing
    local pm="$1" what="$2" missing sudo=
    shift 2
    [ "$(id -u)" = 0 ] || sudo=sudo
    missing=$(linux_missing "$pm" "$*")
    if [ -n "$missing" ]; then
        say "Installing $what with $pm (asks for your password):"
        hint "$missing"
        case "$pm" in
            # shellcheck disable=SC2086
            apt) $sudo apt-get update && $sudo apt-get install -y $missing ;;
            dnf) $sudo dnf install -y $missing ;;
            pacman) $sudo pacman -S --needed --noconfirm $missing ;;
        esac || return 1
    fi
    ok "$what ($pm)"
}

# The pinned QEMU as a prebuilt download (no compiler needed).  Returns
# nonzero, having changed nothing that matters, when there isn't one for
# this machine: the caller then builds QEMU instead.
setup_linux_prebuilt() {
    local pm sha arch url tmp
    say "Checking this Linux machine"
    ok "Linux $(uname -r) ($(uname -m))"
    pm=$(linux_pm)
    case "$pm" in
        apt) linux_install apt "run-time libraries" $APT_RUNTIME_DEPS || {
                 warn "could not install the prebuilt QEMU's libraries; building QEMU instead"
                 return 1; } ;;
        dnf|pacman) linux_install "$pm" "dependencies" $(linux_deps "$pm") || return 1 ;;
        *) return 1 ;;
    esac
    sha=$(git -C "$REPO" rev-parse HEAD:qemu 2>/dev/null) || return 1
    if [ -f "$PREBUILT_DIR/VERSION" ] && [ "$(cat "$PREBUILT_DIR/VERSION")" = "$sha" ] &&
       [ -x "$PREBUILT_DIR/bin/qemu-system-ppc" ]; then
        ok "prebuilt QEMU (${sha:0:12}) already here"
        setup_vulkan_check
        return 0
    fi
    case "$(uname -m)" in x86_64|amd64) arch=x86_64 ;; aarch64|arm64) arch=aarch64 ;; *) return 1 ;; esac
    url="https://github.com/$PREBUILT_REPO/releases/download/qemu-${sha:0:12}/ppcosx-qemu-linux-$arch.tar.xz"
    tmp=$(mktemp -d)
    say "Downloading a prebuilt QEMU (${sha:0:12}, $arch)"
    if [ -n "${PPCOSX_QEMU_TARBALL:-}" ]; then
        cp "$PPCOSX_QEMU_TARBALL" "$tmp/q.tar.xz" || { rm -rf "$tmp"; return 1; }
    elif ! curl -fsSL -o "$tmp/q.tar.xz" "$url"; then
        warn "no prebuilt QEMU for this version yet; building it instead"
        rm -rf "$tmp"
        return 1
    fi
    if ! tar -C "$tmp" -xJf "$tmp/q.tar.xz" || [ ! -x "$tmp/ppcosx-qemu/bin/qemu-system-ppc" ]; then
        warn "the prebuilt QEMU download is damaged; building QEMU instead"
        rm -rf "$tmp"
        return 1
    fi
    local libs
    libs=$(ldd "$tmp/ppcosx-qemu/bin/qemu-system-ppc" 2>&1 | grep "not found" | awk '{print $1}' | tr '\n' ' ')
    if [ -n "$libs" ] || ! "$tmp/ppcosx-qemu/bin/qemu-system-ppc" --version >/dev/null 2>&1; then
        warn "the prebuilt QEMU does not run here${libs:+ (missing: $libs)}; building it instead"
        rm -rf "$tmp"
        return 1
    fi
    rm -rf "$PREBUILT_DIR"
    mv "$tmp/ppcosx-qemu" "$PREBUILT_DIR"
    rm -rf "$tmp"
    QEMU="$PREBUILT_DIR/bin/qemu-system-ppc"
    ok "installed $("$QEMU" --version | head -1) (prebuilt)"
    setup_vulkan_check
}

setup_linux() {
    local pm
    pm=$(linux_pm)
    [ -n "$pm" ] || die "no apt-get, dnf or pacman found. Install these (or your
    distribution's names for them), then run $PROG setup again:
    $(echo $APT_DEPS)"
    linux_install "$pm" "build dependencies" $(linux_deps "$pm") \
        || die "installing packages failed; install them yourself and run $PROG setup again"
    setup_vulkan_check
}

setup_vulkan_check() {
    if command -v vulkaninfo >/dev/null 2>&1; then
        local gpu
        gpu=$(vulkaninfo --summary 2>/dev/null | sed -n 's/^[[:space:]]*deviceName[[:space:]]*=[[:space:]]*//p' | head -1)
        [ -n "$gpu" ] && ok "Vulkan: $gpu" || warn "no Vulkan device found; 3D needs a Vulkan driver (Mesa, NVIDIA or AMD)"
    fi
}

setup_mac() {
    local pm missing
    say "Checking this Mac"
    if apple_silicon; then
        ok "Apple Silicon ($(sysctl -n machdep.cpu.brand_string 2>/dev/null))"
        [ "$(uname -m)" = arm64 ] || warn "this shell runs under Rosetta ($(uname -m)); QEMU would be built for Intel. Open a native terminal."
    else
        ok "Intel Mac ($(sysctl -n machdep.cpu.brand_string 2>/dev/null))"
        warn "on an Intel Mac the Radeon renders with Vulkan (MoltenVK), not Metal, and the"
        warn "AltiVec speed-ups (ARM only) don't apply, so expect it to be slower"
    fi
    ok "macOS $(sw_vers -productVersion)"

    if ! xcode-select -p >/dev/null 2>&1; then
        warn "Xcode Command Line Tools are missing; starting the installer"
        xcode-select --install 2>/dev/null || true
        die "finish the Command Line Tools install, then run $PROG setup again"
    fi
    ok "Command Line Tools ($(xcode-select -p))"

    pm=$(mac_pm)
    if [ "$pm" = brew ]; then
        command -v brew >/dev/null 2>&1 || die "Homebrew is required: https://brew.sh
    Install it, open a new terminal, and run $PROG setup again.
    (MacPorts works too: install it from https://www.macports.org/install.php)"
        ok "Homebrew ($(brew --prefix))"
        missing=$(mac_missing brew)
        if [ -n "$missing" ]; then
            say "Installing build dependencies:$missing"
            # shellcheck disable=SC2086
            brew install $missing || die "brew install failed"
        fi
        ok "build dependencies ($BREW_DEPS)"
    else
        command -v port >/dev/null 2>&1 || die "MacPorts is required on an Intel Mac (Homebrew no longer supports Intel).
    Install the package for your macOS version from https://www.macports.org/install.php,
    open a new terminal, and run $PROG setup again."
        ok "MacPorts ($(port version 2>/dev/null | sed 's/Version: //'))"
        missing=$(mac_missing macports)
        if [ -n "$missing" ]; then
            say "Installing build dependencies with MacPorts (asks for your password):"
            hint "$missing"
            local sudo=
            [ "$(id -u)" = 0 ] || sudo=sudo
            # shellcheck disable=SC2086
            $sudo port -N install $missing || die "port install failed (try: sudo port selfupdate)"
        fi
        ok "build dependencies (MacPorts: $PORT_DEPS)"
    fi
}

setup_build() {
    local jobs
    say "Fetching the QEMU source"
    if [ -d "$REPO/.git" ]; then
        git -C "$REPO" submodule update --init --depth 1 qemu \
            || die "could not fetch the qemu submodule (network?)"
    fi
    [ -f "$QEMU_DIR/configure" ] || die "qemu/ is empty; run: git submodule update --init --depth 1 qemu"
    ok "qemu/ at $(git -C "$QEMU_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"

    # QEMU's configure needs a Python with distlib, which recent Homebrew
    # Pythons no longer bundle; keep a small private venv for it.
    local venv="$REPO/.pyvenv"
    if ! "$venv/bin/python3" -c 'import distlib' >/dev/null 2>&1; then
        say "Preparing a Python environment for the build"
        rm -rf "$venv"
        # On macOS, build the venv from Homebrew's own python3, not whatever
        # is first on PATH: a python3 left over from an Intel Homebrew runs
        # under Rosetta and makes meson configure an x86_64 build, which then
        # fails on -mcx16/-msse2.
        local py=python3
        if [ "$HOST_OS" = Darwin ] && [ "$(mac_pm)" = macports ] && [ -x /opt/local/bin/python3.13 ]; then
            py=/opt/local/bin/python3.13
        elif [ "$HOST_OS" = Darwin ] && command -v brew >/dev/null 2>&1 &&
             [ -x "$(brew --prefix)/opt/python@3/libexec/bin/python3" ]; then
            py="$(brew --prefix)/opt/python@3/libexec/bin/python3"
        fi
        "$py" -m venv "$venv" && "$venv/bin/python3" -m pip install -q distlib \
            || die "could not create the Python venv in .pyvenv (python3 -m venv / pip failed)"
    fi
    ok "Python $("$venv/bin/python3" -c 'import platform; print(platform.python_version())') with distlib"

    say "Building QEMU (qemu-system-ppc only; this takes a few minutes)"
    # dtc:werror: the bundled dtc (used without a system libfdt) builds
    # with -Werror of its own, which --disable-werror does not reach, and
    # glibc 2.43's const-preserving strchr makes it warn (Ubuntu 26.04).
    # A build configured without it by an older ppcosx is configured
    # again: meson configure in place would also turn QEMU's -Werror back on.
    if [ -f "$QEMU_BUILD/build.ninja" ] && [ -d "$QEMU_BUILD/subprojects/dtc" ] &&
       ! grep -Eq 'dtc:werror +: false' "$QEMU_BUILD/ppcosx-configure.log" 2>/dev/null; then
        rm -rf "$QEMU_BUILD"
    fi
    mkdir -p "$QEMU_BUILD"
    if [ ! -f "$QEMU_BUILD/build.ninja" ]; then
        (cd "$QEMU_BUILD" && ../configure --python="$venv/bin/python3" \
            --target-list=ppc-softmmu --disable-docs --disable-sdl \
            --disable-werror -Doptimization=2 -Ddtc:werror=false) \
            > "$QEMU_BUILD/ppcosx-configure.log" 2>&1 \
            || { tail -30 "$QEMU_BUILD/ppcosx-configure.log"
                 die "configure failed; full log: qemu/build/ppcosx-configure.log"; }
        ok "configured"
    fi
    jobs=$(ncpu)
    if ! ninja -C "$QEMU_BUILD" -j "$jobs" qemu-system-ppc qemu-img \
            > "$QEMU_BUILD/ppcosx-build.log" 2>&1; then
        grep -E 'error|FAILED' "$QEMU_BUILD/ppcosx-build.log" | head -20
        die "build failed; full log: qemu/build/ppcosx-build.log"
    fi
    ok "built $(basename "$QEMU")"

    setup_done
}

setup_done() {
    mkdir -p "$VM_DIR/roms"
    [ -n "${PPCOSX_INSTALLER:-}" ] && return 0   # install.sh prints its own next steps
    echo
    say "Setup complete. Next:"
    if [ -f "$DISK_DEFAULT" ]; then
        hint "$PROG run"
    else
        hint "$PROG install /path/to/MacOSX-Tiger.iso     (fresh install)"
        hint "$PROG import  /path/to/existing-disk.vmdk   (existing PowerPC OS X disk)"
    fi
}

# ---------------------------------------------------------------- doctor ---
cmd_doctor() {
    local fail=0 v
    say "Host"
    if [ "$IS_MAC" = 1 ]; then
        apple_silicon && ok "Apple Silicon" || warn "Intel Mac: the Radeon uses Vulkan (MoltenVK), and no AltiVec speed-ups"
        ok "macOS $(sw_vers -productVersion)"
        xcode-select -p >/dev/null 2>&1 && ok "Command Line Tools" || { bad "Command Line Tools missing"; hint "xcode-select --install"; fail=1; }
        local mpm mmissing
        mpm=$(mac_pm)
        if [ "$mpm" = brew ] && command -v brew >/dev/null 2>&1; then
            ok "Homebrew"
        elif [ "$mpm" = macports ] && command -v port >/dev/null 2>&1; then
            ok "MacPorts"
        elif [ "$mpm" = brew ]; then
            bad "Homebrew missing (https://brew.sh)"; fail=1
        else
            bad "MacPorts missing (https://www.macports.org/install.php)"; fail=1
        fi
        if [ "$fail" = 0 ]; then
            mmissing=$(mac_missing "$mpm")
            [ -z "$mmissing" ] && ok "build dependencies" \
                || { bad "packages missing:$mmissing"; hint "$PROG setup"; fail=1; }
        fi
    else
        local pm missing
        ok "$HOST_OS $(uname -r) ($(uname -m))"
        pm=$(linux_pm)
        if [ -n "$pm" ]; then
            if [ "$pm" = apt ] && [ -x "$PREBUILT_DIR/bin/qemu-system-ppc" ]; then
                missing=$(linux_missing apt "$APT_RUNTIME_DEPS")
            else
                missing=$(linux_missing "$pm")
            fi
            [ -z "$missing" ] && ok "dependencies ($pm)" \
                || { bad "packages missing:$missing"; hint "$PROG setup"; fail=1; }
        else
            warn "unknown package manager; cannot check dependencies"
        fi
        if command -v vulkaninfo >/dev/null 2>&1; then
            vulkaninfo --summary >/dev/null 2>&1 && ok "Vulkan driver" \
                || { bad "no working Vulkan driver (3D needs one)"; fail=1; }
        fi
    fi

    say "Emulator"
    if [ -x "$QEMU" ]; then
        v=$("$QEMU" --version 2>/dev/null | head -1)
        ok "$v"
        "$QEMU" -device help 2>/dev/null | grep -q ati-radeon-9700 \
            && ok "ati-radeon-9700 device present" \
            || { bad "this QEMU has no ati-radeon-9700 device"; fail=1; }
    else
        bad "QEMU not built"; hint "$PROG setup"; fail=1
    fi
    for f in "$FW_RADEON/openbios-ppc" "$FW_RADEON/ppc-ndrvloader" "$FW_RADEON/qemu_vga_hwc.ndrv" \
             "$FW_VGA/openbios-ppc" "$FW_VGA/ppc-ndrvloader"; do
        [ -f "$f" ] || { bad "missing ${f#$REPO/}"; fail=1; }
    done
    (cd "$REPO/firmware" && sha1_check SHA1SUMS >/dev/null 2>&1) \
        && ok "firmware checksums" || { bad "firmware checksums do not match firmware/SHA1SUMS"; fail=1; }

    say "Your files ($VM_DIR)"
    if [ -f "$DISK_DEFAULT" ]; then
        ok "disk ${DISK_DEFAULT#$REPO/} ($(human_size "$(disk_size "$DISK_DEFAULT")"))"
    else
        warn "no disk yet"; hint "$PROG install <iso>   or   $PROG import <disk>"
    fi
    if [ -f "$ROM_DEFAULT" ]; then
        rom_check "$ROM_DEFAULT" >/dev/null && ok "Radeon ROM $(rom_check "$ROM_DEFAULT")" \
            || { bad "vm/roms/radeon9700.rom is not a Mac Radeon 9700 ROM"; fail=1; }
    else
        ok "no Radeon ROM (optional)"
    fi
    echo
    [ $fail = 0 ] && say "${G}All good.${N}" || say "${R}Some checks failed${N} - see above."
    return $fail
}

# ------------------------------------------------------------------- rom ---
# Print "vendor:device (Open Firmware)" for a Mac ATI ROM; fail otherwise.
rom_check() {
    /usr/bin/python3 - "$1" <<'PY'
import struct, sys
d = open(sys.argv[1], 'rb').read()
if len(d) < 0x40 or d[:2] != b'\x55\xaa':
    sys.exit("not a PCI option ROM (no 55 AA signature)")
p = struct.unpack('<H', d[0x18:0x1a])[0]
if d[p:p+4] != b'PCIR':
    sys.exit("no PCI data structure")
ven, dev = struct.unpack('<HH', d[p+4:p+8])
code = d[p+0x14]
if ven != 0x1002:
    sys.exit("vendor %04x is not ATI" % ven)
if dev != 0x4e44:
    sys.exit("device %04x:%04x is not a Radeon 9700 PRO (1002:4e44)" % (ven, dev))
if code != 1:
    sys.exit("this is a PC ROM (code type %d); a Mac (Open Firmware) ROM is needed" % code)
print("%04x:%04x, Open Firmware, %d KB" % (ven, dev, len(d) // 1024))
PY
}

cmd_rom() {
    [ $# -ge 1 ] || die "usage: $PROG rom <file.rom>   (or: $PROG rom --remove)"
    if [ "$1" = --remove ]; then
        rm -f "$ROM_DEFAULT"; ok "ROM removed; the Radeon runs without one"; return
    fi
    [ -f "$1" ] || die "no such file: $1"
    local info
    info=$(rom_check "$1" 2>&1) || die "$1: $info"
    mkdir -p "$VM_DIR/roms"
    cp "$1" "$ROM_DEFAULT"
    ok "installed ROM ($info) as ${ROM_DEFAULT#$REPO/}"
}

# -------------------------------------------------------------- new-disk ---
cmd_new_disk() {
    local size="${1:-40G}" disk="${2:-$DISK_DEFAULT}"
    [ -e "$disk" ] && die "$disk already exists (delete it first to start over)"
    mkdir -p "$(dirname "$disk")"
    # lazy refcounts: fewer metadata flushes; metadata preallocation: no
    # cluster-table growth stalls while the guest installs.
    qemu_img create -q -f qcow2 -o lazy_refcounts=on,preallocation=metadata "$disk" "$size" \
        || die "qemu-img create failed"
    ok "created empty $size disk ${disk#$REPO/}"
}

# ---------------------------------------------------------------- import ---
cmd_import() {
    local force=0 src= dst="$DISK_DEFAULT" f
    while [ $# -gt 0 ]; do
        case "$1" in
            --force) force=1 ;;
            --as) shift; dst=$(abspath "$1") ;;
            -*) die "unknown option $1" ;;
            *) src="$1" ;;
        esac
        shift
    done
    [ -n "$src" ] || die "usage: $PROG import <disk image or .utm bundle> [--as out.qcow2] [--force]"
    [ -e "$src" ] || die "no such file: $src"
    src=$(abspath "$src")

    if [ -d "$src" ]; then   # UTM bundle: take the largest disk image in Data/
        f=$(ls -S "$src"/Data/*.qcow2 "$src"/Data/*.img 2>/dev/null | head -1)
        [ -n "$f" ] || die "$src has no Data/*.qcow2 or Data/*.img disk"
        say "Using the UTM disk $(basename "$f")"
        src="$f"
    fi
    case "$src" in
        *.dmg|*.iso|*.cdr|*.toast) die "$(basename "$src") looks like an installer; use: $PROG install \"$src\"" ;;
    esac
    if [ -e "$dst" ] && [ $force = 0 ]; then
        die "${dst#$REPO/} already exists. Use --force to replace it, or --as other.qcow2"
    fi

    say "Converting $(basename "$src") to ${dst#$REPO/} (your original is not modified)"
    mkdir -p "$(dirname "$dst")"
    qemu_img convert -p -O qcow2 "$src" "$dst.part" || { rm -f "$dst.part"; die "conversion failed"; }
    mv -f "$dst.part" "$dst"
    ok "imported"
    hint "Boot it:  $PROG run$( [ "$dst" != "$DISK_DEFAULT" ] && printf ' --disk %s' "$dst")"
}

# ------------------------------------------------------------- snapshots ---
cmd_snapshot() {
    local disk="$DISK_DEFAULT" action="${1:-list}"
    [ $# -gt 0 ] && shift
    [ -f "$disk" ] || die "no disk at ${disk#$REPO/}"
    if disk_in_use "$disk"; then
        die "the VM is running; shut it down first"
    fi
    case "$action" in
        list)    qemu_img snapshot -l "$disk" ;;
        save)    [ $# = 1 ] || die "usage: $PROG snapshot save <name>"
                 qemu_img snapshot -c "$1" "$disk" && ok "saved snapshot '$1'" ;;
        restore) [ $# = 1 ] || die "usage: $PROG snapshot restore <name>"
                 qemu_img snapshot -a "$1" "$disk" && ok "disk restored to '$1'" ;;
        delete)  [ $# = 1 ] || die "usage: $PROG snapshot delete <name>"
                 qemu_img snapshot -d "$1" "$disk" && ok "deleted snapshot '$1'" ;;
        *) die "usage: $PROG snapshot list|save|restore|delete [name]" ;;
    esac
}

# Resolve a DVD/CD image into something QEMU can read; sets DVD_PATH.
# .iso .cdr .toast are used as-is.  A .dmg is usually compressed UDIF,
# which QEMU can't read, so it's converted once (hdiutil) to a raw .cdr
# kept in the VM folder, and redone if the .dmg is newer.
dvd_image() {
    local src="$1" cdr
    [ -f "$src" ] || die "no such DVD image: $src"
    case "$src" in
        *.dmg|*.DMG)
            cdr="$VM_DIR/dvd-$(basename "${src%.*}").cdr"
            if [ ! -f "$cdr" ] || [ "$src" -nt "$cdr" ]; then
                say "Converting $(basename "$src") to a raw DVD image (one time)"
                mkdir -p "$VM_DIR"
                rm -f "$cdr"
                if [ "$IS_MAC" = 1 ]; then
                    hdiutil convert "$src" -format UDTO -o "${cdr%.cdr}" -quiet \
                        || die "hdiutil could not convert $src"
                else
                    command -v dmg2img >/dev/null 2>&1 \
                        || die "converting a .dmg needs dmg2img (e.g. sudo apt install dmg2img)"
                    dmg2img -s "$src" "$cdr" || die "dmg2img could not convert $src"
                fi
            fi
            DVD_PATH="$cdr" ;;
        *) DVD_PATH="$src" ;;
    esac
    # A retail Leopard DVD image is one bare HFS+ volume.  OpenBIOS only boots
    # a disc whose volume is in an Apple_HFS partition (as on Tiger's DVD), so
    # give such an image a partition map, once.
    if /usr/bin/python3 "$REPO/tools/apm-wrap.py" check "$DVD_PATH"; then
        cdr="$VM_DIR/dvd-$(basename "${src%.*}").cdr"
        if [ "$DVD_PATH" = "$cdr" ] || [ ! -f "$cdr" ] || [ "$src" -nt "$cdr" ]; then
            say "Adding a partition map to $(basename "$src") so OpenBIOS can boot it (one time)"
            mkdir -p "$VM_DIR"
            /usr/bin/python3 "$REPO/tools/apm-wrap.py" wrap "$DVD_PATH" "$cdr.part" \
                && mv -f "$cdr.part" "$cdr" \
                || { rm -f "$cdr.part"; die "could not add a partition map to $src"; }
        fi
        DVD_PATH="$cdr"
    fi
}

# ------------------------------------------------------------------- run ---
# Shared by run and install.  Sets the global array QARGS.
build_common() {   # $1 = disk, $2 = "cd" when booting from CD
    local HOST_UI
    local AUDIO
    if [ "$IS_MAC" = 1 ]; then AUDIO=coreaudio; HOST_UI=(-display cocoa)
    else AUDIO=pa; HOST_UI=(-display gtk,zoom-to-fit=on); fi
    # --no-audio: the Mac still has its sound chip, but nothing reaches
    # the host's audio system (for hosts where that misbehaves).
    [ "$NO_AUDIO" = 1 ] && AUDIO=none
    HOST_UI+=(-audio "$AUDIO")
    # cpu-mhz is a machine option of this repo's QEMU; an older build
    # (git pull without ppcosx update) doesn't have it yet.
    MACHINE="mac99,via=pmu"
    if "$QEMU" -machine mac99,help 2>/dev/null | grep -q cpu-mhz; then
        MACHINE="$MACHINE,cpu-mhz=$CPU_MHZ"
    else
        warn "this QEMU build can't set the CPU speed; run: $PROG update"
    fi
    local hdboot=,bootindex=0
    [ "${2:-}" = cd ] && hdboot=
    QARGS=(-nodefaults -vga none
        -machine "$MACHINE" -accel tcg,tb-size=256
        -smp cpus=1,sockets=1,cores=1,threads=1 -m "$RAM"
        "${HOST_UI[@]}"
        -drive "if=none,media=disk,id=hd,file.filename=$1,discard=unmap,detect-zeroes=unmap,l2-cache-size=64M,cache-clean-interval=0"
        -device "ide-hd,bus=ide.0,unit=0,drive=hd$hdboot")
    [ "$SNAPSHOT" = 1 ] && QARGS+=(-snapshot)
    if [ "$MONITOR" = 1 ]; then
        port_free 4444 && port_free 4445 || die "port 4444 or 4445 is in use (another VM running?)"
        QARGS+=(-monitor tcp:127.0.0.1:4444,server,nowait -qmp tcp:127.0.0.1:4445,server,nowait)
    fi
}

# Forth for the boot command: with --model, make NAME the first entry of
# the root "compatible" list, which is where Mac OS X's hw.model comes from
# (apps such as Aperture check it).  The rest keeps what the platform
# drivers match on.  The machine itself doesn't change.
model_forth() {
    [ -n "$MODEL" ] || return 0
    printf '%s ' "\" /\" find-device" \
        "\" $MODEL\" encode-string" \
        "\" MacRISC\" encode-string encode+" \
        "\" MacRISC2\" encode-string encode+" \
        "\" Power Macintosh\" encode-string encode+" \
        "\" compatible\" property device-end"
}

# Added after the display device, so the display keeps its PCI slot.
add_net() {
    local net="user,id=net0,ipv6=off"
    if [ -n "$SSH_PORT" ]; then
        port_free "$SSH_PORT" || die "port $SSH_PORT is in use"
        net="$net,hostfwd=tcp:127.0.0.1:$SSH_PORT-:22"
    fi
    QARGS+=(-netdev "$net" -device sungem,netdev=net0)
}

parse_run_opts() {
    DISK="$DISK_DEFAULT"; RAM=1024; VRAM=128; RES=1024x768; ROM=; CD=
    CPU_MHZ="${PPCOSX_CPU_MHZ:-$CPU_MHZ_DEFAULT}"; MODEL="${PPCOSX_MODEL:-$MODEL_DEFAULT}"
    VERBOSE=0; SNAPSHOT=0; SSH_PORT=; MONITOR=0; TRACE=0; MODE=radeon
    NO_AUDIO="${PPCOSX_NO_AUDIO:-0}"
    GPU="${PPCOSX_GPU:-}"
    [ -n "$GPU" ] || { apple_silicon && GPU=metal || GPU=vulkan; }
    EXTRA=()
    [ -f "$ROM_DEFAULT" ] && ROM="$ROM_DEFAULT"
    while [ $# -gt 0 ]; do
        case "$1" in
            --disk) DISK=$(abspath "$2"); shift ;;
            --ram) RAM="$2"; shift ;;
            --cpu-mhz) CPU_MHZ="$2"; shift ;;
            --model) MODEL="$2"; shift ;;
            --vram) VRAM="$2"; shift ;;
            --res) RES="$2"; shift ;;
            --rom) ROM=$(abspath "$2"); shift ;;
            --no-rom) ROM= ;;
            --attach-dvd|--dvd|--cd)
                [ $# -ge 2 ] || die "$1 needs a path to a .iso, .cdr, .dmg or .toast"
                CD=$(abspath "$2"); shift ;;
            --vga) MODE=vga ;;
            --gpumetal) GPU=metal ;;
            --gpuvulkan) GPU=vulkan ;;
            --gpu) [ $# -ge 2 ] || die "--gpu takes metal or vulkan"
                   GPU="$2"; shift ;;
            --gpu=*) GPU="${1#--gpu=}" ;;
            --verbose|-v) VERBOSE=1 ;;
            --snapshot) SNAPSHOT=1 ;;
            --no-audio) NO_AUDIO=1 ;;
            --ssh-port) SSH_PORT="$2"; shift ;;
            --monitor) MONITOR=1 ;;
            --trace-gpu) TRACE=1 ;;
            --) shift; EXTRA=("$@"); break ;;
            -h|--help) usage; exit 0 ;;
            *) die "unknown option: $1 (see $PROG help)" ;;
        esac
        shift
    done
    case "$RAM" in ''|*[!0-9]*) die "--ram takes a number of MB" ;; esac
    [ "$RAM" -ge 256 ] && [ "$RAM" -le 2048 ] || die "--ram must be 256-2048 (mac99 limit is 2 GB)"
    case "$VRAM" in 64|128|256) ;; *) die "--vram must be 64, 128 or 256" ;; esac
    case "$CPU_MHZ" in ''|*[!0-9]*) die "--cpu-mhz takes a number of MHz" ;; esac
    case "$MODEL" in
        default|none|'') MODEL= ;;
        *[!A-Za-z0-9,._-]*) die "--model takes a Mac model name like PowerBook5,8" ;;
    esac
    [ "$CPU_MHZ" -ge 100 ] && [ "$CPU_MHZ" -le 4000 ] || die "--cpu-mhz must be 100-4000"
    case "$RES" in [0-9]*x[0-9]*) ;; *) die "--res looks like 1024x768" ;; esac
    case "$GPU" in metal|vulkan) ;; *) die "--gpu takes metal or vulkan" ;; esac
    [ "$GPU" = metal ] && [ "$IS_MAC" = 0 ] && die "Metal is macOS only; on $HOST_OS use --gpu vulkan"
    [ "$GPU" = metal ] && ! apple_silicon && die "the Metal renderer needs an Apple Silicon GPU; on an Intel Mac use --gpu vulkan (the default)"
    [ -z "$CD" ] || [ -f "$CD" ] || die "no such DVD image: $CD"
    if [ -n "$ROM" ]; then
        [ -f "$ROM" ] || die "no such ROM: $ROM"
        local info; info=$(rom_check "$ROM" 2>&1) || die "$ROM: $info"
    fi
}

cmd_run() {
    need_qemu
    parse_run_opts "$@"
    [ -f "$DISK" ] || die "no disk at ${DISK#$REPO/}
    Install Mac OS X first:  $PROG install <tiger.iso>
    or bring a disk:         $PROG import <disk.vmdk|.qcow2|.utm>"
    if disk_in_use "$DISK"; then
        die "a VM is already running on $(basename "$DISK"); shut it down first"
    fi

    build_common "$DISK"
    [ "$VERBOSE" = 1 ] && QARGS+=(-prom-env 'boot-args=-v')
    QARGS+=(-usb -device usb-mouse,bus=usb-bus.0 -device usb-kbd,bus=usb-bus.0)
    if [ -n "$CD" ]; then
        dvd_image "$CD"
        QARGS+=(-drive "if=none,media=cdrom,id=cd,readonly=on,file=$DVD_PATH"
                -device ide-cd,bus=ide.0,unit=1,drive=cd)
    fi

    if [ "$MODE" = vga ]; then
        # UTM's "PowerPC G4" preset: QEMU VGA with the QEMU NDRV.  No 3D.
        QARGS=(-L "$FW_VGA" -L "$QEMU_DATA" "${QARGS[@]}"
            -device loader,addr=0x4000000,file="$FW_VGA/ppc-ndrvloader"
            -prom-env "boot-command=$(model_forth)init-program go"
            -device VGA,edid=on -g "${RES}x32"
            -device ich9-usb-ehci1,id=usb-controller-0
            -device ich9-usb-uhci1,masterbus=usb-controller-0.0,firstport=0,multifunction=on
            -device ich9-usb-uhci2,masterbus=usb-controller-0.0,firstport=2,multifunction=on
            -device ich9-usb-uhci3,masterbus=usb-controller-0.0,firstport=4,multifunction=on
            -device virtio-tablet-pci
            -device usb-tablet,bus=usb-bus.0)   # absolute pointer for tools/vmctl.py
        say "Booting ${DISK#$REPO/} with the plain VGA framebuffer (no 3D)"
    else
        # The Radeon is pinned to PCI slot $RADEON_SLOT so the node path below
        # is always right: /pci@f2000000/QEMU,VGA@e.
        # The firmware's display table is patched to 1002:4E44, so OpenBIOS
        # builds /pci@f2000000/QEMU,VGA@e for the Radeon and the QEMU NDRV
        # (plus hardware cursor) drives the framebuffer; Tiger's
        # ATIRadeon9700.kext then attaches for 2D/3D.  The node keeps
        # name/compatible "QEMU,VGA" (the NDRV matches on them) and gets the
        # 9700 PRO FCode's identity, which System Profiler reports as
        # "ATI Radeon 9700 Pro", plus the VRAM size.
        local vram_hex boot
        vram_hex=$(printf %x $((VRAM * 1048576)))
        boot="$(model_forth)\" /pci@f2000000/QEMU,VGA@$RADEON_SLOT\" ['] find-device catch 0= if"
        boot="$boot h# $vram_hex encode-int \" VRAM,totalsize\" property"
        boot="$boot \" ATY,R300\" encode-string \" model\" property"
        boot="$boot \" 113-A06500-124\" encode-string \" ATY,Rom#\" property"
        boot="$boot \" 109-A06501-00\" encode-string \" ATY,Card#\" property"
        boot="$boot \" 1.88\" encode-string \" ATY,Fcode\" property"
        boot="$boot device-end then init-program go"

        local dev="ati-radeon-9700,addr=$RADEON_SLOT.0,vgamem_mb=$VRAM,renderer=$GPU"
        if [ -n "$ROM" ]; then dev="$dev,romfile=$ROM,biosrom=$ROM"
        else dev="$dev,romfile="; fi

        export QEMU_PPC_NDRV="$FW_RADEON/qemu_vga_hwc.ndrv"
        QARGS=(-L "$FW_RADEON" -L "$QEMU_DATA" "${QARGS[@]}"
            -device loader,addr=0x4000000,file="$FW_RADEON/ppc-ndrvloader"
            -prom-env "boot-command=$boot"
            -global uni-north-pci.agp-capable=on
            -device "$dev" -g "${RES}x32"
            -device usb-tablet,bus=usb-bus.0
            -D "$VM_DIR/gpu-trace.log")
        if [ "$TRACE" = 1 ]; then QARGS+=(-trace 'ppc_mac_gpu_*')
        else QARGS+=(-trace ppc_mac_gpu_realize); fi
        say "Booting ${DISK#$REPO/} with the ATI Radeon 9700 PRO ($VRAM MB, $GPU${ROM:+, ROM $(basename "$ROM")})"
    fi
    add_net
    if [ "$IS_MAC" = 1 ]; then
        hint "Release the mouse: Ctrl+Option+G.  Quit: shut down Mac OS X, or Cmd+Q the QEMU window."
    else
        hint "Release the mouse: Ctrl+Alt+G.  Quit: shut down Mac OS X, or close the QEMU window."
    fi
    [ "$SNAPSHOT" = 1 ] && hint "--snapshot: nothing you do in this session is saved to the disk."

    mkdir -p "$VM_DIR"
    exec "$QEMU" "${QARGS[@]}" ${EXTRA[@]+"${EXTRA[@]}"}
}

# --------------------------------------------------------------- install ---
cmd_install() {
    need_qemu
    local iso= size=40G args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --size) size="$2"; shift ;;
            --disk|--ram|--res|--cpu-mhz) args+=("$1" "$2"); shift ;;
            --verbose|-v|--monitor) args+=("$1") ;;
            -*) die "unknown option $1" ;;
            *) iso=$(abspath "$1") ;;
        esac
        shift
    done
    [ -n "$iso" ] || die "usage: $PROG install <Mac OS X install DVD: .iso .cdr .dmg .toast> [--size 40G]"
    [ -f "$iso" ] || die "no such file: $iso"

    dvd_image "$iso"
    iso="$DVD_PATH"

    parse_run_opts ${args[@]+"${args[@]}"}
    if [ ! -f "$DISK" ]; then
        cmd_new_disk "$size" "$DISK"
    else
        warn "installing onto the existing disk ${DISK#$REPO/}"
    fi

    # Plain OpenBIOS CD boot (-boot d) with UTM's firmware and QEMU VGA:
    # the installer does not need the Radeon, and this is the setup the
    # Tiger installer is known to work with.  -no-reboot turns the
    # installer's final restart into a clean exit.
    build_common "$DISK" cd
    QARGS=(-L "$FW_VGA" -L "$QEMU_DATA" "${QARGS[@]}"
        -device VGA,edid=on -g "${RES}x32"
        -drive "if=none,media=cdrom,id=cd,readonly=on,file=$iso"
        -device ide-cd,bus=ide.1,unit=0,drive=cd,bootindex=0
        -boot d -no-reboot
        -usb -device usb-mouse,bus=usb-bus.0 -device usb-kbd,bus=usb-bus.0
        -device usb-tablet,bus=usb-bus.0)   # absolute pointer for tools/vmctl.py
    [ "$VERBOSE" = 1 ] && QARGS+=(-prom-env 'boot-args=-v')
    add_net

    cat <<EOF
${B}Installing Mac OS X from $(basename "$iso") onto ${DISK#$REPO/}${N}

  1. Pick a language. When the installer opens, choose ${B}Utilities > Disk Utility${N}.
  2. Select the QEMU hard disk, ${B}Erase${N} it as "Mac OS Extended (Journaled)",
     then quit Disk Utility.
  3. Continue the installer and pick the new volume. The install takes
     roughly 30-60 minutes; "Customize" and unticking printer drivers and
     extra languages makes it much faster.
  4. When it restarts, this window closes. Then boot it with:  ${B}$PROG run${N}

EOF
    exec "$QEMU" "${QARGS[@]}"
}

# ------------------------------------------------------ link / update ---
# Put ppcosx on the PATH: Homebrew's bin if it's writable and on the PATH
# (no shell edits needed), else ~/.local/bin, added to the shell profile.
cmd_link() {
    local bin= rc= line
    if command -v brew >/dev/null 2>&1; then
        bin="$(brew --prefix)/bin"
        case ":$PATH:" in *":$bin:"*) [ -w "$bin" ] || bin= ;; *) bin= ;; esac
    fi
    if [ -z "$bin" ]; then
        bin="$HOME/.local/bin"
        mkdir -p "$bin"
        case ":$PATH:" in
            *":$bin:"*) ;;
            *)
                case "${SHELL:-}" in
                    */bash) [ "$IS_MAC" = 1 ] && rc="$HOME/.bash_profile" || rc="$HOME/.bashrc" ;;
                    */zsh) rc="$HOME/.zshrc" ;;
                    *) rc="$HOME/.profile" ;;
                esac
                line='export PATH="$HOME/.local/bin:$PATH"   # added by ppcosx'
                grep -qF "$line" "$rc" 2>/dev/null || printf '\n%s\n' "$line" >> "$rc"
                ;;
        esac
    fi
    if [ -e "$bin/ppcosx" ] && [ ! -L "$bin/ppcosx" ]; then
        die "$bin/ppcosx exists and isn't a link; move it away and run: $PROG link"
    fi
    ln -sfn "$REPO/ppcosx" "$bin/ppcosx" || die "could not create $bin/ppcosx"
    ok "linked $bin/ppcosx -> $REPO/ppcosx"
    if [ -n "$rc" ]; then
        hint "Added $bin to your PATH in $rc; open a new terminal window to use 'ppcosx'."
    fi
}

cmd_unlink() {
    local f
    for f in "$(brew --prefix 2>/dev/null)/bin/ppcosx" "$HOME/.local/bin/ppcosx"; do
        if [ -L "$f" ] && [ "$(resolve "$f")" = "$REPO/ppcosx" ]; then
            rm -f "$f" && ok "removed $f"
        fi
    done
    hint "Your VMs are untouched in ${VM_DIR}; the program itself is in $REPO."
}

cmd_update() {
    [ -d "$REPO/.git" ] || die "$REPO is not a git checkout; reinstall with the one-line installer"
    say "Updating $REPO"
    git -C "$REPO" pull --ff-only || die "git pull failed (local changes in $REPO?)"
    # setup fetches the new qemu/ source itself when it has to build it
    cmd_setup
}

# ------------------------------------------------------------------ main ---
# "ppcosx --vga" is short for "ppcosx run --vga", and a bare "ppcosx" boots
# the VM once there is one to boot.
if [ $# -eq 0 ]; then
    if [ -x "$QEMU" ] && [ -f "$DISK_DEFAULT" ]; then set -- run; else set -- help; fi
fi
case "$1" in -h|--help) ;; -*) set -- run "$@" ;; esac
cmd="$1"
shift
case "$cmd" in
    setup)            cmd_setup "$@" ;;
    doctor|check)     cmd_doctor "$@" ;;
    run|start|boot)   cmd_run "$@" ;;
    install)          cmd_install "$@" ;;
    import)           cmd_import "$@" ;;
    rom)              cmd_rom "$@" ;;
    new-disk)         cmd_new_disk "$@" ;;
    snapshot|snap)    cmd_snapshot "$@" ;;
    update|upgrade)   cmd_update "$@" ;;
    link)             cmd_link "$@" ;;
    unlink)           cmd_unlink "$@" ;;
    help|-h|--help)   usage ;;
    *) printf 'unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
